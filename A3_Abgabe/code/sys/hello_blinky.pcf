set_io clk_12MHz 21    # 12 MHz: Pin 21
set_io clk_50MHz 52    # 50MHz: Pin 52
set_io reset_port 122 # button 1

set_io leds[0]   112 # LED0
set_io leds[1]   113 # LED1
set_io leds[2]   114 # LED2
set_io leds[3]   115 # LED3
set_io leds[4]   116 # LED4
set_io leds[5]   117 # LED5
set_io leds[6]   118 # LED6
set_io leds[7]   119 # LED7

